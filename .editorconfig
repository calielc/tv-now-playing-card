# EditorConfig: https://editorconfig.org
# The same file is in every repository of the owner. Change it in the setup-github-repo skill, then copy it to the repositories.
# The formatter of each language and Git (.gitattributes) use the same values. The formatter config sets the line width.

# The top-most EditorConfig file. No file above this folder counts.
root = true

# ----------------------------------------------------------------------------
# All files
# ----------------------------------------------------------------------------
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# ----------------------------------------------------------------------------
# Languages with two spaces
# ----------------------------------------------------------------------------

# TypeScript and JavaScript.
[*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}]
indent_size = 2

# JSON. npm writes package.json and package-lock.json with two spaces.
[*.{json,jsonc,json5}]
indent_size = 2

# YAML: GitHub workflows, Dependabot, Home Assistant. YAML does not allow tabs.
[*.{yml,yaml}]
indent_size = 2

# HTML and CSS.
[*.{html,htm,css,scss,less,vue,svelte}]
indent_size = 2

# Shell scripts. They must have LF line endings.
[*.{sh,bash,zsh}]
indent_size = 2
end_of_line = lf

# Markdown. Two spaces at the end of a line are a line break, and a long line is fine.
[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = off

# ----------------------------------------------------------------------------
# Languages with four spaces or tabs
# ----------------------------------------------------------------------------

# Python, Rust, Java, Kotlin, C# and PowerShell use four spaces.
[*.{py,pyi,rs,java,kt,kts,cs,csx,ps1,psm1}]
indent_size = 4

# .NET project and solution files.
[*.{csproj,props,targets,sln,slnx}]
indent_size = 2

# Makefiles, Go and Git files need tabs.
[{Makefile,makefile,*.mk,*.go,.gitconfig,.gitmodules}]
indent_style = tab

# Windows batch files need CRLF, as in .gitattributes.
[*.{bat,cmd}]
end_of_line = crlf

# ----------------------------------------------------------------------------
# Files that must keep every character
# ----------------------------------------------------------------------------

# A patch, a snapshot or a lock file of another tool must not change.
[*.{diff,patch,snap,lock}]
trim_trailing_whitespace = false
insert_final_newline = unset

# The license text keeps its own layout.
[{LICENSE,LICENSE.*,COPYING}]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false

# Minified and built files are not for people to edit.
[*.min.{js,css}]
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
max_line_length = off
